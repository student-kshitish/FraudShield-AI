FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .

RUN pip install --no-cache-dir -r requirements-api.txt

COPY AIML-01/phase09_fastapi_server.py /app/AIML-01/phase09_fastapi_server.py
COPY models/xgboost_fraud_model.json /app/models/xgboost_fraud_model.json
COPY reports/phase03_feature_report.json /app/reports/phase03_feature_report.json

ENV PYTHONPATH=/app/AIML-01

EXPOSE 8000

CMD ["sh", "-c", "uvicorn phase09_fastapi_server:app --host 0.0.0.0 --port ${PORT:-8000}"]
