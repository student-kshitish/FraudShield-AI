FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-phase11.txt .
RUN pip install --no-cache-dir -r requirements-phase11.txt

COPY AIML-01/phase09_fastapi_server.py /app/AIML-01/phase09_fastapi_server.py
COPY AIML-01/phase11_dashboard.py /app/AIML-01/phase11_dashboard.py

EXPOSE 8000 8501
